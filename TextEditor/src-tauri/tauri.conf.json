{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zoomi's editor",
  "version": "1.4.4",
  "identifier": "com.nez.drafteditor",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Zoomi's editor",
        "width": 800,
        "height": 600,
        "decorations": false,
        "label": "main", "visible": false, "backgroundColor": "#2c2c2c"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "msi",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
